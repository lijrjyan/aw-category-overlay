<Window x:Class="ActivityWatch.CategoryOverlay.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ActivityWatch Category Overlay Settings"
        Width="820"
        Height="540"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.8*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="1.4*" />
    </Grid.ColumnDefinitions>

    <GroupBox Grid.Row="0" Grid.Column="0" Header="Available categories" Padding="8">
      <ListBox x:Name="AvailableList"
               ItemsSource="{Binding AvailableCategories}"
               DisplayMemberPath="DisplayName" />
    </GroupBox>

    <StackPanel Grid.Row="0"
                Grid.Column="1"
                Margin="10"
                VerticalAlignment="Center">
      <Button Content="Add →" Width="76" Margin="0,0,0,8" Click="Add_Click" />
      <Button Content="← Remove" Width="76" Click="Remove_Click" />
    </StackPanel>

    <GroupBox Grid.Row="0" Grid.Column="2" Header="Overlay order and thresholds" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="TargetList" ItemsSource="{Binding Targets}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DataContext.Directions,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Direction}"
                          Margin="4,0" />
                <TextBox Grid.Column="2"
                         Text="{Binding HoursText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="h"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="4"
                         Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
          <Button Content="Move up" Width="74" Margin="0,0,8,0" Click="MoveUp_Click" />
          <Button Content="Move down" Width="74" Click="MoveDown_Click" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="52" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Refresh" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1"
                Margin="8,0,18,0"
                ItemsSource="{Binding RefreshIntervals}"
                SelectedItem="{Binding RefreshMinutes}" />
      <TextBlock Grid.Column="2"
                 Text="Bar font size"
                 VerticalAlignment="Center" />
      <Slider Grid.Column="3"
              Margin="8,0,18,0"
              Minimum="10"
              Maximum="24"
              TickFrequency="1"
              IsSnapToTickEnabled="True"
              Value="{Binding BarFontSize}" />
      <TextBlock Grid.Column="4"
                 Text="{Binding BarFontSize}"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Row="1"
                 Grid.Column="2"
                 Margin="0,8,0,0"
                 Text="Opacity"
                 VerticalAlignment="Center" />
      <Slider Grid.Row="1"
              Grid.Column="3"
              Margin="8,8,18,0"
              Minimum="0.35"
              Maximum="1"
              TickFrequency="0.05"
              IsSnapToTickEnabled="True"
              Value="{Binding Opacity}" />
      <TextBlock Grid.Row="1"
                 Grid.Column="4"
                 Margin="0,8,0,0"
                 Text="{Binding Opacity, StringFormat={}{0:F2}}"
                 VerticalAlignment="Center" />
      <CheckBox Grid.Column="5"
                Grid.RowSpan="2"
                Content="Start with Windows"
                VerticalAlignment="Center"
                IsChecked="{Binding StartWithWindows}" />
    </Grid>

    <Grid Grid.Row="2" Grid.ColumnSpan="3">
      <TextBlock Text="{Binding ValidationMessage}"
                 Foreground="#C94B4B"
                 VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="82" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Content="Save" Width="82" IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
