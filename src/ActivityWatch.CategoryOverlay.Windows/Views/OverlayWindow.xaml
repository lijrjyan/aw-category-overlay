<Window x:Class="ActivityWatch.CategoryOverlay.Windows.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ActivityWatch Category Overlay"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
  <Window.Resources>
    <Style x:Key="CategoryBarText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize">
        <Setter.Value>
          <Binding Path="DataContext.BarFontSize"
                   RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OverlayProgress" TargetType="ProgressBar">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    ClipToBounds="True">
              <Grid>
                <Border x:Name="PART_Track" />
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="6" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="8"
          Padding="14"
          Background="#B30F172A"
          BorderBrush="#24FFFFFF"
          BorderThickness="1"
          CornerRadius="14"
          Opacity="{Binding OverlayOpacity}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22"
                        ShadowDepth="6"
                        Opacity="0.28"
                        Color="#000000" />
    </Border.Effect>
    <StackPanel>
      <Grid Margin="1,0,1,13" Opacity="{Binding HeaderOpacity}">
        <TextBlock Text="{Binding HeaderText}"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="16"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding LastRefreshText}"
                   HorizontalAlignment="Right"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="16" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="34" Margin="0,0,0,9">
              <ProgressBar Minimum="0"
                           Maximum="1"
                           Value="{Binding FillFraction}"
                           Foreground="{Binding FillBrush}"
                           Style="{StaticResource OverlayProgress}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="60*" />
                  <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="9,0,9,0">
                  <TextBlock Text="{Binding DisplayName}"
                             Style="{StaticResource CategoryBarText}"
                             VerticalAlignment="Center"
                             Foreground="#F2FFFFFF"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,0,54,0" />
                  <TextBlock Text="{Binding ThresholdText}"
                             Style="{StaticResource CategoryBarText}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="#B8FFFFFF"
                             FontWeight="SemiBold" />
                </Grid>
                <Border Grid.Column="0"
                        HorizontalAlignment="Right"
                        Width="1"
                        Background="#C8FFFFFF" />
                <Grid Grid.Column="1">
                  <TextBlock Text="{Binding RequirementText}"
                             Style="{StaticResource CategoryBarText}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="9,0,0,0"
                             Foreground="#A8FFFFFF"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding ActualText}"
                             Style="{StaticResource CategoryBarText}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="42,0,9,0"
                             Foreground="#F2FFFFFF"
                             FontWeight="Bold" />
                </Grid>
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
